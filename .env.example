AI_GATEWAY_API_KEY=
PARAM_EVE_MODEL=openai/gpt-5.4-mini
DATABASE_URL=
PARAM_INTERNAL_API_ORIGIN=
PARAM_INTERNAL_API_SECRET=
PARAM_PUBLIC_BASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional full override. Usually prefer PARAM_PUBLIC_BASE_URL.
# Must end in /eve/v1/telegram when set.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_BOT_USERNAME=param_bot
TELEGRAM_BOT_ID=

# Comma-separated Telegram IDs. Empty means denied unless unrestricted local/dev access is enabled.
PARAM_ALLOWED_TELEGRAM_USER_IDS=
PARAM_ALLOWED_TELEGRAM_CHAT_IDS=
PARAM_TRUSTED_TELEGRAM_USER_IDS=
PARAM_TRUSTED_TELEGRAM_MENTIONS=
# JSON objects keyed by Telegram group/supergroup chat id.
# When a group has configured trusted reviewers, approvals stay in that chat.
# When it does not, PARAM_TRUSTED_TELEGRAM_USER_IDS get DM notifications.
# Approval still happens in the original Telegram chat.
PARAM_TRUSTED_TELEGRAM_USER_IDS_BY_CHAT=
PARAM_TRUSTED_TELEGRAM_MENTIONS_BY_CHAT=
PARAM_ALLOW_UNRESTRICTED_TELEGRAM=false

# When true, allowed group messages can wake Param even without a mention/reply.
# Param may still stay quiet after reading them.
PARAM_TELEGRAM_AMBIENT_GROUP_MESSAGES=false

# Ceiling on separate Telegram bubbles per reply, to keep bursts small.
# Overflow is merged into the last bubble, never dropped. Defaults to 6.
PARAM_TELEGRAM_MAX_MESSAGES=6

# Runtime adapter credentials. Each adapter stays disabled until its var(s) are
# set; the runners are wired per provider once creds + a runner exist.
PARAM_CODEX_API_KEY=
PARAM_OPENCODE_API_KEY=
PARAM_ANTIGRAVITY_API_KEY=
PARAM_BROWSER_PROVIDER_URL=
PARAM_IMAGE_PROVIDER_API_KEY=
